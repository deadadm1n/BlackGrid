# WatchDog Helper bridge token.
AETHERREACH_BRIDGE_TOKEN=

# Minecraft event receiver token.
MINECRAFT_EVENT_RECEIVER_TOKEN=

# Discord bot token.
DISCORD_BOT_TOKEN=

# Discord OAuth application client ID.
DISCORD_CLIENT_ID=

# Discord OAuth application client secret.
DISCORD_CLIENT_SECRET=

# Public callback URL, for example http://192.168.1.157:1337/discord/oauth/callback.
DISCORD_REDIRECT_URI=

# Web panel token.
WEB_PANEL_TOKEN=

# Java executable override.
ATM11_JAVA=
