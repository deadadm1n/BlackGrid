# Wrapper name.
wrapper:
  name: "WatchDog"

  # Enables verbose logs.
  debug: false

# Runtime folders.
paths:
  logs_dir: "logs"
  state_dir: "state"
  backups_dir: "backups"
  downloads_dir: "downloads"
  tmp_dir: "tmp"

# Minecraft server launch.
server:
  directory: "atm11"
  start_script: "auto"
  java_executable: "${ATM11_JAVA:-auto}"
  required_java_major: 25

  # Stop command sent to Minecraft.
  stop_command: "stop"

  # Startup wait time.
  startup_timeout_seconds: 1800

  # Shutdown wait time.
  shutdown_timeout_seconds: 180

  # Mirrors Minecraft output.
  show_minecraft_console: false

  # Saves Minecraft output.
  save_minecraft_console_log: true

  # Extra server environment.
  environment:
    ATM11_RESTART: "false"

  # Lines that mean startup worked.
  startup_success_patterns:
    - 'For help, type "help"'

  # Lines that mean startup failed.
  startup_failure_patterns:
    - "Failed to start the minecraft server"
    - "Crash report saved"
    - "This crash report has been saved"
    - "A fatal error has been detected"
    - "FatalStartupException"
    - "session.lock: already locked"

# Local bridges.
bridges:
  # WatchDog Helper bridge.
  aetherreach:
    enabled: false
    url: ""
    token: "${AETHERREACH_BRIDGE_TOKEN:-}"
    timeout_seconds: 3

  # Minecraft event receiver.
  minecraft_events:
    enabled: false
    host: "127.0.0.1"
    port: 25591
    token: "${MINECRAFT_EVENT_RECEIVER_TOKEN:-}"

# Web control panel.
web_panel:
  enabled: false
  host: "127.0.0.1"
  port: 8080
  token: "${WEB_PANEL_TOKEN:-}"

  # Panel auth settings.
  auth:
    required_op_level: 2
    code_ttl_seconds: 180
    session_ttl_seconds: 28800

# Wrapper plugins.
plugins:
  # ATM11 server pack updater.
  atm11_auto_update:
    enabled: true
    server_dir: "atm11"
    update_dir: "updates/atm11"
    backup_dir: "backups/atm11_updates"

    # Update check timing.
    check_interval_minutes: 60
    initial_check_delay_seconds: 60

    # Download behavior.
    auto_download: true
    auto_apply_on_scheduled_restart: true
    manifest_url: "https://raw.githubusercontent.com/deadadm1n/BlackGrid/main/configs/atm11-serverfiles.json"
    curseforge_scrape_fallback: false
    postpone_failed_file_ids: true
    keep_backups_days: 7
    notify_discord: false
    version_channel_id: 1510814785271234641
    changelog_channel_id: 1512810676501090385

    # Optional manual override.
    # Leave blank for manifest checks. Set manual_file_id or manual_download_url
    # to force the updater to use a known ServerFiles release.
    manual_file_id: ""
    manual_display_name: ""
    manual_page_url: ""
    manual_download_url: ""

    # Folders replaced by pack updates.
    replace_dirs:
      - "config"
      - "defaultconfigs"
      - "kubejs"
      - "libraries"
      - "mods"

    # Files replaced by pack updates.
    replace_files:
      - "run.sh"
      - "startserver.sh"
      - "server-setup-config.yaml"
      - "user_jvm_args.txt"

    # Mod jars preserved during updates.
    preserve_custom_mods:
      - "watchdog_helper-*.jar"
      - "watchdog_helper.jar"
      - "aetherreachcore-*.jar"
      - "worldedit-mod-7.4.3.jar"

    # Paths preserved during updates.
    preserve_paths:
      - "aetherreach"
      - "config/watchdog_helper-common.toml"
      - "config/aetherreachcore-common.toml"
      - "world/serverconfig/ftbranks"
      - "config/worldedit"

  # Crash and schedule restarts.
  auto_restart:
    enabled: false
    enabled_monitoring: true

    # Crash restart timing.
    restart_delay_seconds: 30
    post_stop_delay_seconds: 10
    max_crashes_in_window: 3
    crash_window_minutes: 10

    # Scheduled restart times.
    scheduled_restarts:
      enabled: false
      check_interval_seconds: 30
      times: []

    # Countdown seconds.
    restart_countdown_seconds:
      - 300
      - 60
      - 30
      - 10
      - 5
      - 4
      - 3
      - 2
      - 1

  # Discord bridge and ranks.
  discord_bot:
    enabled: false
    server_name: ""
    helper_name: ""
    channel_id: 0
    guild_id: 0
    token: "${DISCORD_BOT_TOKEN:-}"

    # Discord linking and community roles.
    ranks:
      enabled: false
      create_missing_roles: true
      sync_on_link: true
      sync_on_join: true
      link_command: "!link"
      link_ttl_seconds: 600
      manage_permission: "manage_roles"
      default_role_color: "#99aab5"

      oauth:
        enabled: false
        client_id: "${DISCORD_CLIENT_ID:-}"
        client_secret: "${DISCORD_CLIENT_SECRET:-}"
        redirect_uri: "${DISCORD_REDIRECT_URI:-}"

      roles:
        owner:
          name: "Owner"
          color: "#f1c40f"
        staff:
          name: "Staff"
          color: "#3498db"
        vip:
          name: "VIP"
          color: "#9b59b6"
        loyal:
          name: "Loyal"
          color: "#2ecc71"
        member:
          name: "Member"
          color: "#99aab5"
          auto_assign: true

  # Log cleanup.
  log_rotation:
    enabled: false
    keep_days: 7
    rotate_on_wrapper_start: true
    minecraft_logs_dir: "atm11/logs"

  # Minecraft event bridge.
  minecraft_events:
    enabled: false

  # GitHub release updater.
  update_manager:
    enabled: false
    repository: ""
    update_dir: "updates/manager"
    backup_dir: "backups/update_manager"
    auto_download: false

    # Update targets.
    targets:
      watchdog:
        type: "wrapper"
        display_name: "WatchDog"
        current_version: "0.0.0"
        tag_prefix: "watchdog-v"
        asset_pattern: "watchdog-wrapper-*.zip"
        preserve_paths:
          - ".env"
          - "config/wrapper.yaml"
          - "logs"
          - "state"
          - "backups"
          - "downloads"
          - "tmp"
          - "atm11"
          - "updates"

      watchdog_helper:
        type: "minecraft_mod"
        display_name: "WatchDog Helper"
        server_name: ""
        current_version: "0.0.0"
        tag_prefix: "watchdog-helper-v"
        asset_pattern: "watchdog_helper-*.jar"
        install_dir: "atm11/mods"
        install_name: "watchdog_helper.jar"
        replace_patterns:
          - "watchdog_helper*.jar"

  # Legacy manual updater.
  auto_update:
    enabled: false
    mode: "manual_url"
    update_enabled: false
    latest_file_id: 0
    latest_display_name: ""
    download_url: ""
    patch_file: "plugins/auto_update/patches.yaml"
